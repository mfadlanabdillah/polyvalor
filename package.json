{
  "name": "polyvalor",
  "version": "1.0.0",
  "description": "Low-poly tactical 5v5 shooter inspired by Valorant, with AI bots",
  "author": "Fadlan",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "app:dev": "electron . --dev",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.fadlan.polyvalor",
    "productName": "PolyValor",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PolyValor"
    },
    "portable": {
      "artifactName": "PolyValor-${version}-portable.exe"
    }
  }
}
